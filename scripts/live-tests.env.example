# Copy to scripts/live-tests.env (git-ignored) and fill in. Read by scripts/Run-LiveTests.ps1.
# Never commit the filled-in copy: it holds a personal access token.

# Workspace host without https://, e.g. dbc-1234abcd-5678.cloud.databricks.com
DATABRICKS_HOST=dbc-1234abcd-5678.cloud.databricks.com

# User Settings > Developer > Access tokens > Generate new token
DATABRICKS_TOKEN=dapi-your-token-here

# SQL Warehouses > (your warehouse) > Connection details: the id at the end of the HTTP path
# /sql/1.0/warehouses/<id>
DATABRICKS_WAREHOUSE_ID=0123456789abcdef

# Catalog for the fixtures and the EF Core temporary schemas. Free Edition creates `workspace`.
DATABRICKS_CATALOG=workspace
