<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>BricksNet.EntityFrameworkCore</AssemblyName>
    <RootNamespace>BricksNet.EntityFrameworkCore</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Match the core library: XML docs are written for the public surface but not yet enforced. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- EF1001: EF Core providers are built on EF's "internal" (pubternal) APIs by design, as the
         SQLite, SQL Server and Npgsql providers are. -->
    <NoWarn>$(NoWarn);EF1001</NoWarn>

    <!-- NuGet package metadata. Shared properties and the version come from src/Directory.Build.props. -->
    <PackageId>BricksNet.EntityFrameworkCore</PackageId>
    <Description>Entity Framework Core 10 provider for Databricks SQL, built on BricksNet: LINQ, raw SQL, SaveChanges and ExecuteUpdate/ExecuteDelete over Delta tables.</Description>
    <PackageTags>databricks;databricks-sql;entity-framework-core;efcore;ef-core;sql;delta;lakehouse</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BricksNet\BricksNet.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BricksNet.EntityFrameworkCore.Tests" />
  </ItemGroup>

</Project>
