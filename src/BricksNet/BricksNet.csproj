<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>BricksNet</AssemblyName>
    <RootNamespace>BricksNet</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- NuGet package metadata. Shared properties and the version come from src/Directory.Build.props. -->
    <PackageId>BricksNet</PackageId>
    <Description>Databricks SQL client for .NET 10: a fluent async API and an ADO.NET provider (Dapper-compatible) for SQL Warehouses (REST) and all-purpose clusters (Thrift), with Arrow, CloudFetch, PAT and OAuth support.</Description>
    <PackageTags>databricks;databricks-sql;sql;ado.net;dapper;spark;delta;lakehouse;arrow;thrift</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- Tracks the public API in PublicAPI.Shipped.txt / PublicAPI.Unshipped.txt, so every change to
         it is visible in review. Build-time only. -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- HTTP transport, DI and logging -->
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <!-- Thrift backend -->
    <PackageReference Include="ApacheThrift" />
  </ItemGroup>

  <ItemGroup>
    <!-- Result handling: Arrow and LZ4 -->
    <PackageReference Include="Apache.Arrow" />
    <PackageReference Include="K4os.Compression.LZ4" />
    <PackageReference Include="K4os.Compression.LZ4.Streams" />
  </ItemGroup>

  <ItemGroup>
    <!-- Generated Thrift code is hand-ported (see Backends/Thrift/Generated/README) and
         excluded from style/doc analysis to mirror compiler-generated output. -->
    <None Remove="Backends\Thrift\Generated\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Expose internal test seams (the HTTP pipeline, the OAuthPkceAuthProvider browser-launch ctor) to the test projects. -->
    <InternalsVisibleTo Include="BricksNet.Tests" />
    <InternalsVisibleTo Include="BricksNet.IntegrationTests" />
    <!-- Moq's proxy generator, so the unit tests can mock the internal backend contracts. -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

</Project>
