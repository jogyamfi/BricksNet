<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>BricksNet</AssemblyName>
    <RootNamespace>BricksNet</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Suppress missing XML doc warnings until public API is defined in Phase 2+ -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- NuGet package metadata (Phase 12) -->
    <PackageId>BricksNet</PackageId>
    <Version>0.1.0-alpha</Version>
    <Authors>James Gyamfi</Authors>
    <Company>JamesGyamfi</Company>
    <Description>BricksNet — Databricks SQL client library for .NET 10</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/your-org/bricksnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/your-org/bricksnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <!-- Phase 3 — HTTP Transport Layer -->
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!-- Phase 10 — Fluent API self-contained service provider -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <!-- Phase 5 — Thrift Code Generation & Transport -->
    <PackageReference Include="ApacheThrift" />
  </ItemGroup>

  <ItemGroup>
    <!-- Phase 7 — Result Handling -->
    <PackageReference Include="Apache.Arrow" />
    <PackageReference Include="K4os.Compression.LZ4" />
    <PackageReference Include="K4os.Compression.LZ4.Streams" />
  </ItemGroup>

  <ItemGroup>
    <!-- Generated Thrift code is hand-ported (see Backends/Thrift/Generated/README) and
         excluded from style/doc analysis to mirror compiler-generated output. -->
    <None Remove="Backends\Thrift\Generated\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Include the solution-level README in the NuGet package. -->
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Source Link: enables stepping into BricksNet source from NuGet (build-time only). -->
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Expose internal test seams (e.g. OAuthPkceAuthProvider browser-launch ctor) to unit tests. -->
    <InternalsVisibleTo Include="BricksNet.Tests" />
  </ItemGroup>

</Project>
