<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Suppress missing XML doc warnings in test projects -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- ConfigureAwait is irrelevant in test code (no synchronization context to capture). -->
    <NoWarn>$(NoWarn);CA2007</NoWarn>
    <!-- Tests resolve the provider's internal EF services to assert on them. -->
    <NoWarn>$(NoWarn);EF1001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BricksNet.EntityFrameworkCore\BricksNet.EntityFrameworkCore.csproj" />
  </ItemGroup>

</Project>
